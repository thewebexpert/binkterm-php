            {"asset_path": "assets/PROAUDIO.DRV", "dos_path": "C:/LSL1VGA/PROAUDIO.DRV"},
            {"asset_path": "assets/RESOURCE.000", "dos_path": "C:/LSL1VGA/RESOURCE.000"},
            {"asset_path": "assets/RESOURCE.001", "dos_path": "C:/LSL1VGA/RESOURCE.001"},
            {"asset_path": "assets/RESOURCE.002", "dos_path": "C:/LSL1VGA/RESOURCE.002"},
            {"asset_path": "assets/RESOURCE.CFG", "dos_path": "C:/LSL1VGA/RESOURCE.CFG"},
            {"asset_path": "assets/RESOURCE.MAP", "dos_path": "C:/LSL1VGA/RESOURCE.MAP"},
            {"asset_path": "assets/SCIDHUV.EXE", "dos_path": "C:/LSL1VGA/SCIDHUV.EXE"},
