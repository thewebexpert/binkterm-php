                    {"asset_path": "assets/VGA320.DRV", "dos_path": "C:/LSL1VGA/VGA320.DRV", "optional": true},
                    {"asset_path": "assets/VGA320BW.DRV", "dos_path": "C:/LSL1VGA/VGA320BW.DRV", "optional": true}
                ],
                "autoexec": [
                    "C:",
                    "cd LSL1VGA",
                    "SET BLASTER=A220 I7 D1 T4",
                    "INSTALL.EXE"
