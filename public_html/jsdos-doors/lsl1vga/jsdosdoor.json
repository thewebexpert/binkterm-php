    "saves": {
        "enabled": true,
        "scope": "user",
        "save_paths": [
            "C:/LSL1VGA/LSL1SG.*",
            "C:/LSL1VGA/*.SAV",
            "C:/LSL1VGA/RESOURCE.CFG"
        ],
