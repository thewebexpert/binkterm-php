                    {"asset_path": "assets/IBMKBD.DRV", "dos_path": "C:/LSL1VGA/IBMKBD.DRV", "optional": true},
                    {"asset_path": "assets/JOYSTICK.DRV", "dos_path": "C:/LSL1VGA/JOYSTICK.DRV", "optional": true},
