            {"asset_path": "assets/JOYSTICK.DRV", "dos_path": "C:/LSL1VGA/JOYSTICK.DRV"},
            {"asset_path": "assets/LARRY.DRV", "dos_path": "C:/LSL1VGA/LARRY.DRV"},
