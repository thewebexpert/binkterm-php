{
    "id": "lsl1vga",
    "name": "Leisure Suit Larry in the Land of the Lounge Lizards (VGA)",
    "version": "1.0",
    "author": "Sierra On-Line",
    "description": "Guide 38-year-old Larry Laffer in his polyester suit through Lost Wages in this 1991 VGA remake of the legendary adult comedy adventure.",
    "icon": "icon.png",
    "genre": ["JSDOS", "Adventure", "Comedy"],
    "emulator": "jsdos",
