{# Hide header banner on door games / terminal player pages #}
<script>
(function() {
    var p = window.location.pathname;
    if (p.startsWith('/games/') || p.startsWith('/guest-doors/')) {
        document.documentElement.classList.add('is-game-play-page');
    }
})();
</script>
<style>
.is-game-play-page main.container::before,
.is-game-play-page main.bbs-shell-main::before {
    display: none !important;
    height: 0 !important;
    margin: 0 !important;
}
.is-game-play-page main.container {
    margin-top: 0.5rem !important;
}
</style>
